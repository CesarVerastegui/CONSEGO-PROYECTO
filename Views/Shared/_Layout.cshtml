<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CONSEGO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #e8f0f5 0%, #d9e2ec 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        .navbar {
            background: #2c3e50 !important;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
            color: white !important;
        }

            .navbar-brand i {
                font-size: 1.6rem;
            }

        .nav-link {
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s;
            color: rgba(255,255,255,0.85) !important;
        }

            .nav-link:hover {
                background-color: rgba(255,255,255,0.1);
                color: white !important;
            }

        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            transition: transform 0.2s, box-shadow 0.2s;
            background: white;
        }

            .card:hover {
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            }

        .btn {
            border-radius: 0.5rem;
            font-weight: 500;
            padding: 0.5rem 1rem;
            transition: all 0.2s;
        }

        .btn-sm {
            padding: 0.3rem 0.8rem;
            border-radius: 0.4rem;
        }

        .table {
            vertical-align: middle;
        }

            .table thead th {
                background-color: #e9ecef;
                font-weight: 600;
                border-bottom: 2px solid #ced4da;
            }

        /* --- AJUSTES PARA ELIMINAR SCROLL HORIZONTAL --- */
        .dataTables_wrapper {
            overflow-x: hidden;
        }

            .dataTables_wrapper .row {
                margin-left: 0 !important;
                margin-right: 0 !important;
            }

            .dataTables_wrapper .col-sm-12 {
                padding: 0 !important;
            }

        table.dataTable {
            width: 100% !important;
            margin: 0 !important;
        }

        /* --- ESTILOS COMPONENTES DATATABLES (BUSCADOR Y PAGINACIÓN) --- */
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 1.5rem;
        }

            /* Buscador: Sin sombras ni contornos azules */
            .dataTables_wrapper .dataTables_filter input {
                border-radius: 0.5rem;
                border: 1px solid #dee2e6;
                padding: 0.4rem 0.8rem;
                margin-left: 0.5rem;
                outline: none !important;
                box-shadow: none !important;
            }

                .dataTables_wrapper .dataTables_filter input:focus {
                    border-color: #3b82f6;
                }

        /* Paginación: Limpieza total de los bordes dobles y fondos extraños */
        .dataTables_wrapper .dataTables_paginate {
            padding-top: 1rem;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                padding: 0 !important;
                margin: 0 2px !important;
                border: none !important;
                background: transparent !important;
            }

                /* Estilo para los botones de texto y números */
                .dataTables_wrapper .dataTables_paginate .paginate_button a {
                    display: inline-block;
                    padding: 0.4rem 0.9rem;
                    border-radius: 0.5rem !important;
                    border: 1px solid #dee2e6 !important;
                    background-color: #f8f9fa !important;
                    color: #495057 !important;
                    text-decoration: none !important;
                    transition: all 0.2s;
                    box-shadow: none !important;
                }

                /* Hover para Anterior, Siguiente y números inactivos */
                .dataTables_wrapper .dataTables_paginate .paginate_button:hover a {
                    background-color: #e9ecef !important;
                    color: #212529 !important;
                    border-color: #ced4da !important;
                }

                /* Página Actual: El número azul */
                .dataTables_wrapper .dataTables_paginate .paginate_button.current a {
                    background-color: #3b82f6 !important;
                    border-color: #3b82f6 !important;
                    color: white !important;
                }

                /* Botones deshabilitados */
                .dataTables_wrapper .dataTables_paginate .paginate_button.disabled a {
                    opacity: 0.6;
                    cursor: not-allowed;
                    background-color: #f8f9fa !important;
                }

        /* --- OTROS DETALLES --- */
        table.dataTable > tbody > tr.child ul.dtr-details {
            width: 100%;
        }

        table.dataTable > tbody > tr.child span.dtr-title {
            min-width: 100px;
            font-weight: 600;
        }

        .badge {
            padding: 0.35rem 0.75rem;
            border-radius: 2rem;
            font-weight: 500;
        }

        footer {
            background-color: white;
            border-top: 1px solid #dee2e6;
            color: #6c757d;
        }

        .role-badge {
            font-size: 0.7rem;
            padding: 0.25rem 0.6rem;
        }

        .dataTables_processing {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            color: #3b82f6;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-lock-fill me-2"></i>
                <strong>CONSEGO</strong>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Solicitudes" asp-action="Index">
                                <i class="bi bi-clipboard-list me-1"></i> Solicitudes
                            </a>
                        </li>
                        @if (User.IsInRole("Solicitante") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Solicitudes" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Nueva Solicitud
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear me-1"></i> Administración
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index"><i class="bi bi-tags me-2"></i>Roles</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people me-2"></i>Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Plataformas" asp-action="Index"><i class="bi bi-cloud me-2"></i>Plataformas</a></li>
                                </ul>
                            </li>
                        }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>
                            <span>@User.Identity?.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <span class="dropdown-item-text">
                                    <span class="badge
                                                @(User.IsInRole("Admin") ? "bg-danger" :
                                                                                              User.IsInRole("AnalistaSeguridad") ? "bg-warning text-dark" :
                                                                                              User.IsInRole("Infra") ? "bg-info text-dark" : "bg-secondary")
                                                w-100 py-2">
                                        <i class="bi bi-shield-check me-1"></i>
                                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                    </span>
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 py-2" id="logoutForm">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm w-100" id="logoutBtn">
                                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
                        }
            else
            {
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Auth" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </a>
                </div>
            }
        </div>
    </nav>

    <main>
        <div class="container mt-4">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-5 py-3">
        <div class="container text-center">
            <hr class="my-3">
            <p class="text-muted small mb-0">
                <i class="bi bi-lock-fill me-1"></i> CONSEGO - Sistema de Gestión de Solicitudes de Acceso
                <br>© @DateTime.Now.Year - IDM Technology
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        @if (TempData["Success"] != null)
        {
                    <text>
                    Swal.fire({
                        title: '¡Éxito!',
                        text: '@Html.Raw(TempData["Success"])',
                        icon: 'success',
                        confirmButtonColor: '#3b82f6',
                        timer: 3000,
                        showConfirmButton: true
                    });
                    </text>
        }

        @if (TempData["Error"] != null)
        {
                    <text>
                    Swal.fire({
                        title: '¡Error!',
                        text: '@Html.Raw(TempData["Error"])',
                        icon: 'error',
                        confirmButtonColor: '#dc3545'
                    });
                    </text>
        }

        @if (TempData["Info"] != null)
        {
                    <text>
                    Swal.fire({
                        title: 'Información',
                        text: '@Html.Raw(TempData["Info"])',
                        icon: 'info',
                        confirmButtonColor: '#0dcaf0'
                    });
                    </text>
        }

        document.getElementById('logoutBtn')?.addEventListener('click', function(e) {
            e.preventDefault();
            Swal.fire({
                title: '¿Cerrar sesión?',
                text: 'Serás redirigido al inicio de sesión',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, cerrar sesión',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>