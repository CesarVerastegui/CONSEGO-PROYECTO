@model SolicitudAcceso
@using CONSEGO.Models.Enums

@{
    ViewData["Title"] = $"Solicitud {Model.Codigo}";

    var estadoBadge = Model.Estado switch
    {
        EstadoSolicitud.Registrado => "bg-secondary text-white",
        EstadoSolicitud.EnAnalisis => "bg-primary text-white",
        EstadoSolicitud.Aprobado => "bg-success text-white",
        EstadoSolicitud.Rechazado => "bg-danger text-white",
        EstadoSolicitud.Implementado => "bg-info text-dark",
        _ => "bg-secondary text-white"
    };
}

<div class="container py-4">
    @* Cabecera Estilo Dashboard *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Solicitudes</a></li>
                    <li class="breadcrumb-item active">@Model.Codigo</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">Detalle de Solicitud</h2>
        </div>
        <div class="d-flex gap-2">
            <span class="badge @estadoBadge fs-6 px-3 py-2 shadow-sm rounded-pill d-flex align-items-center">
                <i class="bi bi-circle-fill me-2 small"></i> @Model.Estado
            </span>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <div class="row g-4">
        @* Panel Izquierdo: Datos de la Solicitud *@
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold text-muted">
                        <i class="bi bi-info-circle me-2"></i>Información General
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <label class="text-uppercase small fw-bold text-muted d-block">Solicitante</label>
                            <span class="fs-5 fw-medium">@Model.UsuarioSolicitante?.Nombre</span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-uppercase small fw-bold text-muted d-block">Fecha de Registro</label>
                            <span class="fs-5 fw-medium">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <label class="text-uppercase small fw-bold text-muted d-block">Plataforma</label>
                            <div class="d-flex align-items-center mt-1">
                                <span class="badge bg-light text-dark border px-3">@Model.Plataforma?.Nombre</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-uppercase small fw-bold text-muted d-block">Tipo de Acceso</label>
                            <span class="badge bg-light text-primary border px-3 mt-1">@Model.TipoAcceso</span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="text-uppercase small fw-bold text-muted mb-2 d-block">Justificación del Acceso</label>
                        <div class="p-3 bg-light rounded-3 border text-dark shadow-sm" style="min-height: 100px; line-height: 1.6;">
                            @Model.Justificacion
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Panel Derecho: Resolución y Acciones *@
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold text-muted">
                        <i class="bi bi-shield-check me-2"></i>Estado de Resolución
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush border-top-0">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted">Analista Asignado:</span>
                            <span class="fw-bold">@(Model.Analista?.Nombre ?? "Por asignar")</span>
                        </li>
                        @if (Model.FechaDecision.HasValue)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <span class="text-muted">Fecha de Decisión:</span>
                                <span class="fw-bold">@Model.FechaDecision.Value.ToString("dd/MM/yyyy")</span>
                            </li>
                        }
                    </ul>

                    @* Mensajes Dinámicos según Estado *@
                    @if (!string.IsNullOrEmpty(Model.ObservacionesSeguridad))
                    {
                        <div class="mt-4">
                            <label class="fw-bold text-primary small text-uppercase">Observaciones Seguridad</label>
                            <div class="alert alert-primary border-0 bg-opacity-10 py-3 mt-2">
                                <i class="bi bi-chat-quote-fill me-2"></i> @Model.ObservacionesSeguridad
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.MotivoRechazo))
                    {
                        <div class="mt-4">
                            <label class="fw-bold text-danger small text-uppercase">Motivo de Rechazo</label>
                            <div class="alert alert-danger border-0 py-3 mt-2">
                                <i class="bi bi-exclamation-octagon-fill me-2"></i> @Model.MotivoRechazo
                            </div>
                        </div>
                    }

                    @if (Model.Estado == EstadoSolicitud.Registrado)
                    {
                        <div class="alert alert-warning border-0 mt-3 d-flex align-items-center">
                            <div class="spinner-grow spinner-grow-sm me-3 text-warning" role="status"></div>
                            <span class="small">Pendiente de toma por parte de seguridad.</span>
                        </div>
                    }
                </div>
            </div>

            @* Botonera de Acciones Contextuales *@
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && Model.Estado == EstadoSolicitud.Registrado)
                        {
                            <form asp-action="Tomar" asp-route-id="@Model.Id" method="post" id="tomarForm">
                                @Html.AntiForgeryToken()
                                <button type="button" id="tomarBtn" class="btn btn-warning w-100 shadow-sm fw-bold">
                                    <i class="bi bi-hand-index-thumb me-2"></i>Tomar para Análisis
                                </button>
                            </form>
                        }

                        @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && Model.Estado == EstadoSolicitud.EnAnalisis)
                        {
                            <a asp-action="Resolver" asp-route-id="@Model.Id" class="btn btn-success w-100 shadow-sm fw-bold">
                                <i class="bi bi-check2-square me-2"></i>Resolver Ahora
                            </a>
                        }

                        @if ((User.IsInRole("Infra") || User.IsInRole("Admin")) && Model.Estado == EstadoSolicitud.Aprobado)
                        {
                            <form asp-action="Implementar" asp-route-id="@Model.Id" method="post" id="implementarForm">
                                @Html.AntiForgeryToken()
                                <button type="button" id="implementarBtn" class="btn btn-info w-100 shadow-sm fw-bold text-dark">
                                    <i class="bi bi-gear-fill me-2"></i>Marcar Implementado
                                </button>
                            </form>
                        }

                        @if (Model.Estado == EstadoSolicitud.Implementado)
                        {
                            <div class="text-center py-2 text-success fw-bold">
                                <i class="bi bi-check-circle-fill fs-5"></i><br>Proceso Finalizado
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tomarBtn').on('click', function() {
                Swal.fire({
                    title: '¿Tomar solicitud?',
                    text: 'Se le asignará formalmente esta revisión.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    confirmButtonText: 'Sí, tomar',
                    cancelButtonText: 'Cancelar',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) $('#tomarForm').submit();
                });
            });

            $('#implementarBtn').on('click', function() {
                Swal.fire({
                    title: '¿Confirmar implementación?',
                    text: 'Esta acción notificará que el acceso ya está listo.',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    confirmButtonText: 'Confirmar',
                    cancelButtonText: 'Cancelar',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) $('#implementarForm').submit();
                });
            });
        });
    </script>
}