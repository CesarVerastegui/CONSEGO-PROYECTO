@model SolicitudAcceso
@{
    ViewData["Title"] = $"Solicitud {Model.Codigo}";

    var estadoBadge = Model.Estado switch
    {
        EstadoSolicitud.Registrado => "bg-secondary",
        EstadoSolicitud.EnAnalisis => "bg-primary",
        EstadoSolicitud.Aprobado => "bg-success",
        EstadoSolicitud.Rechazado => "bg-danger",
        EstadoSolicitud.Implementado => "bg-info",
        _ => "bg-secondary"
    };
}

<h3>Detalle de Solicitud <span class="badge @estadoBadge">@Model.Estado</span></h3>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Código:</strong> @Model.Codigo</p>
                <p><strong>Fecha de Solicitud:</strong> @Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Solicitante:</strong> @Model.UsuarioSolicitante?.Nombre</p>
                <p><strong>Plataforma:</strong> @Model.Plataforma?.Nombre</p>
                <p><strong>Tipo de Acceso:</strong> @Model.TipoAcceso</p>
            </div>
            <div class="col-md-6">
                <p><strong>Justificación:</strong></p>
                <div class="alert alert-light">@Model.Justificacion</div>
                <p><strong>Analista Asignado:</strong> @(Model.Analista?.Nombre ?? "Sin asignar")</p>
                @if (Model.FechaDecision.HasValue)
                {
                    <p><strong>Fecha de Decisión:</strong> @Model.FechaDecision.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
                @if (!string.IsNullOrEmpty(Model.ObservacionesSeguridad))
                {
                    <p><strong>Observaciones de Seguridad:</strong></p>
                    <div class="alert alert-info">@Model.ObservacionesSeguridad</div>
                }
                @if (!string.IsNullOrEmpty(Model.MotivoRechazo))
                {
                    <p><strong>Motivo de Rechazo:</strong></p>
                    <div class="alert alert-danger">@Model.MotivoRechazo</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && Model.Estado == EstadoSolicitud.Registrado)
    {
        <form asp-action="Tomar" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning">Tomar para Análisis</button>
        </form>
    }

    @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && Model.Estado == EstadoSolicitud.EnAnalisis)
    {
        <a asp-action="Resolver" asp-route-id="@Model.Id" class="btn btn-success">Resolver</a>
    }

    @if ((User.IsInRole("Infra") || User.IsInRole("Admin")) && Model.Estado == EstadoSolicitud.Aprobado)
    {
        <form asp-action="Implementar" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-info">Marcar Implementado</button>
        </form>
    }

    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>
