@model SolicitudAcceso
@{
    ViewData["Title"] = $"Resolver Solicitud {Model.Codigo}";
}

<h3>Resolver Solicitud: @Model.Codigo</h3>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Solicitante:</strong> @Model.UsuarioSolicitante?.Nombre</p>
        <p><strong>Plataforma:</strong> @Model.Plataforma?.Nombre</p>
        <p><strong>Tipo de Acceso:</strong> @Model.TipoAcceso</p>
        <p><strong>Justificación:</strong></p>
        <div class="alert alert-light">@Model.Justificacion</div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Resolver" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Observaciones de Seguridad</label>
                <textarea name="observacionesSeguridad" class="form-control" rows="3" placeholder="Observaciones del análisis de seguridad..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Motivo de Rechazo (solo si rechaza)</label>
                <textarea name="motivoRechazo" class="form-control" rows="3" placeholder="Motivo del rechazo..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" name="decision" value="Aprobar" class="btn btn-success btn-lg">
                    ? Aprobar
                </button>
                <button type="submit" name="decision" value="Rechazar" class="btn btn-danger btn-lg">
                    ? Rechazar
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>
