@using CONSEGO.DTOs
@using CONSEGO.Models.Enums
@model SolicitudCreateDTO
@{
    ViewData["Title"] = "Nueva Solicitud de Acceso";
}

<h3>Nueva Solicitud de Acceso</h3>

<div class="row">
    <div class="col-md-6">
        <form id="createForm" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PlataformaId" class="form-label">Plataforma</label>
                <select asp-for="PlataformaId" asp-items="@ViewBag.Plataformas" class="form-select">
                    <option value="">-- Seleccione Plataforma --</option>
                </select>
                <span asp-validation-for="PlataformaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoAcceso" class="form-label">Tipo de Acceso</label>
                <select asp-for="TipoAcceso" asp-items="Html.GetEnumSelectList<TipoAcceso>()" class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="TipoAcceso" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Justificacion" class="form-label">Justificación</label>
                <textarea asp-for="Justificacion" class="form-control" rows="4" placeholder="Explique por qué necesita este acceso..."></textarea>
                <span asp-validation-for="Justificacion" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            // Usando validación de jQuery para que funcione con los spans de error
            if (!$(this).valid()) return;

            Swal.fire({
                title: '¿Enviar solicitud?',
                text: 'La solicitud será registrada y enviada al área de seguridad.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar'
            }).then(result => {
                if (result.isConfirmed) this.submit();
            });
        });
    </script>
}