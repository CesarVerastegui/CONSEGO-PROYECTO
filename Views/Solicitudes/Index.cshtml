@model SolicitudFiltroViewModel
@using CONSEGO.Models.Enums
@{
    ViewData["Title"] = "Solicitudes de Acceso";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Solicitudes de Acceso</h3>
    <div>
        @if (User.IsInRole("Solicitante") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nueva Solicitud
            </a>
        }
        <button id="btnExportarExcel" class="btn btn-outline-success ms-2" title="Exportar a Excel">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Filtros</div>
    <div class="card-body">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-2">
                <div class="col-md-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()" class="form-select">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PlataformaId" class="form-label">Plataforma</label>
                    <select asp-for="PlataformaId" class="form-select">
                        <option value="">-- Todas --</option>
                        @foreach (var p in Model.PlataformasDisponibles)
                        {
                            <option value="@p.Id" selected="@(Model.PlataformaId == p.Id)">@p.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="FechaDesde" class="form-label"></label>
                    <input asp-for="FechaDesde" class="form-control" type="date" />
                </div>
                <div class="col-md-2">
                    <label asp-for="FechaHasta" class="form-label"></label>
                    <input asp-for="FechaHasta" class="form-control" type="date" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
                </div>
            </div>
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Fecha</th>
            <th>Solicitante</th>
            <th>Plataforma</th>
            <th>Tipo Acceso</th>
            <th>Estado</th>
            <th>Analista</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Solicitudes.Any())
        {
            <tr><td colspan="8" class="text-center text-muted">No se encontraron solicitudes.</td></tr>
        }
        @foreach (var s in Model.Solicitudes)
        {
            var estadoBadge = s.Estado switch
            {
                EstadoSolicitud.Registrado => "bg-secondary",
                EstadoSolicitud.EnAnalisis => "bg-primary",
                EstadoSolicitud.Aprobado => "bg-success",
                EstadoSolicitud.Rechazado => "bg-danger",
                EstadoSolicitud.Implementado => "bg-info",
                _ => "bg-secondary"
            };
            <tr>
                <td><strong>@s.Codigo</strong></td>
                <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                <td>@s.UsuarioSolicitante?.Nombre</td>
                <td>@s.Plataforma?.Nombre</td>
                <td>@s.TipoAcceso</td>
                <td><span class="badge @estadoBadge">@s.Estado</span></td>
                <td>@(s.Analista?.Nombre ?? "—")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Ver</a>

                    @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.Registrado)
                    {
                        <form asp-action="Tomar" asp-route-id="@s.Id" method="post" class="d-inline tomar-form" data-codigo="@s.Codigo">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-warning tomar-btn">Tomar</button>
                        </form>
                    }

                    @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.EnAnalisis)
                    {
                        <a asp-action="Resolver" asp-route-id="@s.Id" class="btn btn-sm btn-success">Resolver</a>
                    }

                    @if ((User.IsInRole("Infra") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.Aprobado)
                    {
                        <form asp-action="Implementar" asp-route-id="@s.Id" method="post" class="d-inline implementar-form" data-codigo="@s.Codigo">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-info implementar-btn">Implementar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@* ... Paginación se mantiene igual ... *@

@section Scripts {
    <script>
        // Lógica de botones Tomar/Implementar con SweetAlert
        document.querySelectorAll('.tomar-btn, .implementar-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const esTomar = this.classList.contains('tomar-btn');

                Swal.fire({
                    title: esTomar ? '¿Tomar solicitud?' : '¿Marcar implementada?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, confirmar'
                }).then(result => { if (result.isConfirmed) form.submit(); });
            });
        });

        // Exportación corregida para usar el filterForm
        document.getElementById('btnExportarExcel')?.addEventListener('click', function() {
            const formData = new URLSearchParams(new FormData(document.getElementById('filterForm')));
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('@Url.Action("ExportarExcel", "Solicitudes")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: formData.toString()
            })
            .then(res => res.blob())
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Solicitudes_${new Date().getTime()}.xlsx`;
                a.click();
            });
        });
    </script>
}