@model SolicitudFiltroViewModel
@using CONSEGO.Models.Enums
@{
    ViewData["Title"] = "Solicitudes de Acceso";
}

<style>
    /* Estilos Soft Badges Minimalistas */
    .badge-soft {
        display: inline-block;
        padding: 0.4em 0.8em;
        font-size: 0.725rem;
        font-weight: 600;
        border-radius: 50rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .badge-soft-secondary {
        background-color: #f1f5f9;
        color: #475569;
    }

    .badge-soft-primary {
        background-color: #e0f2fe;
        color: #0369a1;
    }

    .badge-soft-success {
        background-color: #dcfce7;
        color: #166534;
    }

    .badge-soft-danger {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .badge-soft-info {
        background-color: #e0f7fa;
        color: #006064;
    }

    /* Ajuste para DataTables unificado con Roles */
    #solicitudesTable thead th {
        background-color: #f8f9fa !important;
        color: #212529 !important;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .btn-white {
        background: #fff;
        color: #666;
        border: 1px solid #dee2e6;
    }

        .btn-white:hover {
            background: #f8f9fa;
            color: #333;
        }
</style>

<div class="container-fluid py-4">
    @* --- ENCABEZADO --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">Listado de Solicitudes</h2>
            <p class="text-muted mb-0">Gestión centralizada de accesos mediante DataTables.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Solicitante") || User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>Nueva Solicitud
                </a>
            }
            <button id="btnExportarExcel" class="btn btn-outline-success shadow-sm">
                <i class="bi bi-file-earmark-excel me-2"></i>Exportar Excel
            </button>
        </div>
    </div>

    @* --- TABLA PRINCIPAL --- *@
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="solicitudesTable" class="table table-striped table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Fecha</th>
                            <th>Solicitante</th>
                            <th>Plataforma</th>
                            <th class="text-center">Estado</th>
                            <th>Analista</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Solicitudes)
                        {
                            var estadoClase = s.Estado switch
                            {
                                EstadoSolicitud.Registrado => "badge-soft-secondary",
                                EstadoSolicitud.EnAnalisis => "badge-soft-primary",
                                EstadoSolicitud.Aprobado => "badge-soft-success",
                                EstadoSolicitud.Rechazado => "badge-soft-danger",
                                EstadoSolicitud.Implementado => "badge-soft-info",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td><span class="fw-bold text-primary">@s.Codigo</span></td>
                                <td>
                                    <div class="small fw-medium">@s.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@s.FechaSolicitud.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-circle me-2 text-muted"></i>
                                        <span class="small">@s.UsuarioSolicitante?.Nombre</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border-0 fw-normal">@s.Plataforma?.Nombre</span></td>
                                <td class="text-center">
                                    <span class="badge-soft @estadoClase">
                                        <i class="bi bi-dot"></i>@s.Estado
                                    </span>
                                </td>
                                <td class="small text-muted">@(s.Analista?.Nombre ?? "—")</td>
                                <td class="text-end">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-white" title="Ver Detalles">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>

                                        @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.Registrado)
                                        {
                                            <form asp-action="Tomar" asp-route-id="@s.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-sm btn-white tomar-btn" title="Tomar">
                                                    <i class="bi bi-hand-index text-warning"></i>
                                                </button>
                                            </form>
                                        }

                                        @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.EnAnalisis)
                                        {
                                            <a asp-action="Resolver" asp-route-id="@s.Id" class="btn btn-sm btn-white" title="Resolver">
                                                <i class="bi bi-check2-circle text-success"></i>
                                            </a>
                                        }

                                        @if ((User.IsInRole("Infra") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.Aprobado)
                                        {
                                            <form asp-action="Implementar" asp-route-id="@s.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-sm btn-white implementar-btn" title="Implementar">
                                                    <i class="bi bi-gear-fill text-info"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Inicialización de DataTable (Copiando configuración de Roles)
            const table = $('#solicitudesTable').DataTable({
                language: {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
                },
                responsive: true,
                order: [[1, 'desc']], // Ordenar por fecha por defecto
                pageLength: 10,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
                columnDefs: [
                    { targets: [6], orderable: false, searchable: false }
                ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });

            // SweetAlert para acciones rápidas
            $(document).on('click', '.tomar-btn, .implementar-btn', function() {
                const form = $(this).closest('form');
                const esTomar = $(this).hasClass('tomar-btn');

                Swal.fire({
                    title: esTomar ? '¿Tomar solicitud?' : '¿Marcar como implementado?',
                    text: esTomar ? 'Se asignará a su perfil para análisis.' : 'Confirmar que el acceso ya fue configurado.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: esTomar ? '#ffc107' : '#0dcaf0',
                    confirmButtonText: 'Sí, confirmar',
                    cancelButtonText: 'Cancelar',
                    reverseButtons: true
                }).then(result => { if (result.isConfirmed) form.submit(); });
            });

            // Exportación (Usa los datos actuales de la tabla)
            $('#btnExportarExcel').on('click', function() {
                Swal.fire({
                    title: 'Generando reporte...',
                    didOpen: () => { Swal.showLoading(); },
                    timer: 1500,
                    showConfirmButton: false
                });

                // Aquí podrías llamar a tu endpoint de exportación
                location.href = '@Url.Action("ExportarExcel", "Solicitudes")';
            });
        });
    </script>
}