@model SolicitudFiltroViewModel
@{
    ViewData["Title"] = "Solicitudes de Acceso";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Solicitudes de Acceso</h3>
    <div>
        @if (User.IsInRole("Solicitante") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nueva Solicitud
            </a>
        }
        <button id="btnExportarExcel" class="btn btn-outline-success ms-2" title="Exportar a Excel">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar
        </button>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-3">
    <div class="card-header">Filtros</div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2">
                <div class="col-md-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoSolicitud>()" class="form-select">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PlataformaId" class="form-label">Plataforma</label>
                    <select asp-for="PlataformaId" class="form-select">
                        <option value="">-- Todas --</option>
                        @foreach (var p in Model.PlataformasDisponibles)
                        {
                            <option value="@p.Id" selected="@(Model.PlataformaId == p.Id)">@p.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="FechaDesde" class="form-label"></label>
                    <input asp-for="FechaDesde" class="form-control" type="date" />
                </div>
                <div class="col-md-2">
                    <label asp-for="FechaHasta" class="form-label"></label>
                    <input asp-for="FechaHasta" class="form-control" type="date" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de solicitudes -->
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Fecha</th>
            <th>Solicitante</th>
            <th>Plataforma</th>
            <th>Tipo Acceso</th>
            <th>Estado</th>
            <th>Analista</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Solicitudes.Any())
        {
            <tr><td colspan="8" class="text-center text-muted">No se encontraron solicitudes.</td></tr>
        }
        @foreach (var s in Model.Solicitudes)
        {
            var estadoBadge = s.Estado switch
            {
                EstadoSolicitud.Registrado => "bg-secondary",
                EstadoSolicitud.EnAnalisis => "bg-primary",
                EstadoSolicitud.Aprobado => "bg-success",
                EstadoSolicitud.Rechazado => "bg-danger",
                EstadoSolicitud.Implementado => "bg-info",
                _ => "bg-secondary"
            };
            <tr>
                <td><strong>@s.Codigo</strong></td>
                <td>@s.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                <td>@s.UsuarioSolicitante?.Nombre</td>
                <td>@s.Plataforma?.Nombre</td>
                <td>@s.TipoAcceso</td>
                <td><span class="badge @estadoBadge">@s.Estado</span></td>
                <td>@(s.Analista?.Nombre ?? "—")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Ver</a>

                    @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.Registrado)
                    {
                        <form asp-action="Tomar" asp-route-id="@s.Id" method="post" class="d-inline tomar-form" data-codigo="@s.Codigo">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-warning tomar-btn">Tomar</button>
                        </form>
                    }

                    @if ((User.IsInRole("AnalistaSeguridad") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.EnAnalisis)
                    {
                        <a asp-action="Resolver" asp-route-id="@s.Id" class="btn btn-sm btn-success">Resolver</a>
                    }

                    @if ((User.IsInRole("Infra") || User.IsInRole("Admin")) && s.Estado == EstadoSolicitud.Aprobado)
                    {
                        <form asp-action="Implementar" asp-route-id="@s.Id" method="post" class="d-inline implementar-form" data-codigo="@s.Codigo">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-info implementar-btn">Implementar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Paginación -->
@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Pagina="@i"
                       asp-route-Estado="@Model.Estado"
                       asp-route-PlataformaId="@Model.PlataformaId"
                       asp-route-FechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                       asp-route-FechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")">@i</a>
                </li>
            }
        </ul>
    </nav>
}
<p class="text-muted text-center">Total: @Model.TotalRegistros solicitudes</p>

@section Scripts {
    <script>
        // Confirmar Tomar solicitud
        document.querySelectorAll('.tomar-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const codigo = form.getAttribute('data-codigo');
                Swal.fire({
                    title: '¿Tomar solicitud?',
                    html: 'La solicitud <strong>' + codigo + '</strong> pasara a estado "En Analisis".',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    confirmButtonText: 'Sí, tomar',
                    cancelButtonText: 'Cancelar'
                }).then(result => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });

        // Confirmar Implementar solicitud
        document.querySelectorAll('.implementar-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const codigo = form.getAttribute('data-codigo');
                Swal.fire({
                    title: '¿Marcar como implementada?',
                    html: 'La solicitud <strong>' + codigo + '</strong> pasara a estado "Implementado".',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0dcaf0',
                    confirmButtonText: 'Sí, implementar',
                    cancelButtonText: 'Cancelar'
                }).then(result => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });

        // Exportar a Excel (sin confirmacion, solo descarga directa)
        document.getElementById('btnExportarExcel')?.addEventListener('click', function() {
            const estado = document.querySelector('#Estado')?.value || '';
            const plataformaId = document.querySelector('#PlataformaId')?.value || '';
            const fechaDesde = document.querySelector('#FechaDesde')?.value || '';
            const fechaHasta = document.querySelector('#FechaHasta')?.value || '';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            const formData = new URLSearchParams();
            if (estado) formData.append('Estado', estado);
            if (plataformaId) formData.append('PlataformaId', plataformaId);
            if (fechaDesde) formData.append('FechaDesde', fechaDesde);
            if (fechaHasta) formData.append('FechaHasta', fechaHasta);

            fetch('@Url.Action("ExportarExcel", "Solicitudes")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: formData.toString()
            })
            .then(response => response.blob())
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                const now = new Date();
                const fechaStr = `${now.getFullYear()}${(now.getMonth()+1).toString().padStart(2,'0')}${now.getDate().toString().padStart(2,'0')}_${now.getHours().toString().padStart(2,'0')}${now.getMinutes().toString().padStart(2,'0')}${now.getSeconds().toString().padStart(2,'0')}`;
                a.download = `Solicitudes_${fechaStr}.xlsx`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            })
            .catch(error => {
                console.error('Error al exportar:', error);
            });
        });
    </script>
}