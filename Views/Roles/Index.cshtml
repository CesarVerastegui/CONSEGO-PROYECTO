@model IEnumerable<Rol>
@{
    ViewData["Title"] = "Roles";
}

<h3>Roles</h3>
<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Rol</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rol in Model)
        {
            <tr>
                <td>@rol.Id</td>
                <td>@rol.Nombre</td>
                <td>@rol.Descripcion</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@rol.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Delete" asp-route-id="@rol.Id" method="post" class="d-inline delete-form" data-name="@rol.Nombre">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger delete-btn">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const name = form.getAttribute('data-name');
                Swal.fire({
                    title: '¿Eliminar rol?',
                    html: `El rol <strong>${name}</strong> se eliminará permanentemente.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then(result => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}