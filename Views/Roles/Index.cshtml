@model IEnumerable<Rol>
@{
    ViewData["Title"] = "Roles";
}

<h3>Roles</h3>
<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Rol</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rol in Model)
        {
            <tr>
                <td>@rol.Id</td>
                <td>@rol.Nombre</td>
                <td>@rol.Descripcion</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@rol.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@rol.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
