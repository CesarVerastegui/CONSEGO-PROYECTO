@model CONSEGO.DTOs.PlataformaCreateDTO
@using CONSEGO.Models.Enums
@{
    ViewData["Title"] = "Crear Plataforma";
}

<h3>Crear Plataforma</h3>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoPlataforma>()" class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Criticidad" class="form-label"></label>
                <select asp-for="Criticidad" asp-items="Html.GetEnumSelectList<Criticidad>()" class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="Criticidad" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Activa" class="form-check-input" />
                <label asp-for="Activa" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>