@model Plataforma
@{
    ViewData["Title"] = "Editar Plataforma";
}

<h3>Editar Plataforma</h3>

<div class="row">
    <div class="col-md-6">
        <form id="editForm" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoPlataforma>()" class="form-select"></select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Criticidad" class="form-label"></label>
                <select asp-for="Criticidad" asp-items="Html.GetEnumSelectList<Criticidad>()" class="form-select"></select>
                <span asp-validation-for="Criticidad" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Activa" class="form-check-input" />
                <label asp-for="Activa" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            Swal.fire({
                title: '¿Actualizar plataforma?',
                text: 'Los cambios se guardarán en el sistema.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                confirmButtonText: 'Sí, actualizar',
                cancelButtonText: 'Cancelar'
            }).then(result => {
                if (result.isConfirmed) this.submit();
            });
        });
    </script>
}