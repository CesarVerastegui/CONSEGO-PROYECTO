@model IEnumerable<CONSEGO.DTOs.PlataformaResponseDTO>
@using CONSEGO.Models.Enums
@{
    ViewData["Title"] = "Plataformas";
}

@Html.AntiForgeryToken() @* Necesario para que el borrado por AJAX funcione *@

<style>
    .badge-soft {
        display: inline-block;
        padding: 0.35em 0.8em;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 50rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .badge-soft-success {
        background-color: #dcfce7;
        color: #166534;
    }

    .badge-soft-danger {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .badge-soft-warning {
        background-color: #fef9c3;
        color: #854d0e;
    }

    .badge-soft-info {
        background-color: #e0f2fe;
        color: #075985;
    }

    .badge-soft-secondary {
        background-color: #f3f4f6;
        color: #374151;
    }

    #tablaPlataformas thead.table-light th {
        background-color: #f8f9fa !important;
        color: #212529 !important;
        border-bottom: 1px solid #dee2e6;
        text-transform: none;
        font-weight: 600;
    }
</style>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h3 class="mb-0">
            <i class="bi bi-cloud me-2 text-primary"></i>Gestión de Plataformas
        </h3>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house me-1"></i>Inicio
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Nueva Plataforma
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaPlataformas" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Criticidad</th>
                        <th>Activa</th>
                        <th class="text-center" style="width: 120px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Nombre</td>
                            <td>
                                <span class="badge-soft badge-soft-info">
                                    <i class="bi bi-layers me-1"></i>@p.Tipo
                                </span>
                            </td>
                            <td>
                                @{
                                    var badgeClass = p.Criticidad switch
                                    {
                                        Criticidad.Alta => "badge-soft-danger",
                                        Criticidad.Media => "badge-soft-warning",
                                        _ => "badge-soft-success"
                                    };
                                }
                                <span class="@badgeClass">@p.Criticidad</span>
                            </td>
                            <td>
                                @if (p.Activa)
                                {
                                    <span class="badge-soft badge-soft-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-soft-secondary">No</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                            onclick="confirmDelete(@p.Id, '@p.Nombre')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaPlataformas').DataTable({
                language: {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
                },
                responsive: true,
                order: [[0, 'desc']],
                pageLength: 10,
                columnDefs: [
                    { targets: [0], width: "80px" },
                    { targets: [5], orderable: false, searchable: false }
                ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });
        });

        function confirmDelete(id, nombre) {
            Swal.fire({
                title: '¿Eliminar plataforma?',
                html: `¿Estás seguro de eliminar ${nombre}?<br><small class="text-danger">Esta acción no se puede deshacer.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-trash3 me-1"></i>Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                showLoaderOnConfirm: true,
                preConfirm: () => {
                    return fetch(`@Url.Action("DeleteConfirmed", "Plataformas")/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(err => { throw new Error(err.message || 'No se pudo eliminar'); });
                        }
                        return response.json();
                    })
                    .catch(error => {
                        Swal.showValidationMessage(`Error: ${error.message}`);
                    });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: '¡Eliminado!',
                        text: 'La plataforma ha sido borrada.',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                }
            });
        }
    </script>
}