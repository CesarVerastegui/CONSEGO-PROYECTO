@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<h3>Usuarios</h3>
<a asp-action="Create" class="btn btn-primary mb-3">Nuevo Usuario</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Activo</th>
            <th>Fecha Creación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Nombre</td>
                <td>@u.Email</td>
                <td><span class="badge bg-secondary">@u.Rol?.Nombre</span></td>
                <td>
                    @if (u.Activo)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline delete-form" data-name="@u.Nombre">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger delete-btn">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const name = form.getAttribute('data-name');
                Swal.fire({
                    title: '¿Eliminar usuario?',
                    html: `El usuario <strong>${name}</strong> se eliminará permanentemente.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then(result => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}